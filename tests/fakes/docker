#!/usr/bin/env bash
# Test double for the docker CLI. It stands in for the archfit engine image so the
# action's scripts run unchanged, and appends every call to FAKE_DOCKER_LOG as one
# JSON line: the options, the engine arguments, and the digest of the policy file the
# "container" was given with --policy.
#
#   FAKE_DOCKER_LOG      JSON lines, one per call (required)
#   FAKE_RESULT          result that `check` prints, emitted by the engine (required for check);
#                        "none" prints nothing, as the engine does on a usage or tool error
#   FAKE_ENGINE_VERSION  version that `--version` reports (default v4.0.0-rc.1)
#   FAKE_PLATFORM        os/arch that `image inspect` reports (default linux/amd64)
#   FAKE_CHECK_RC        exit code of `check`; default is the one its status implies
#                        (pass 0, fail 1, unknown 2), and 2 with FAKE_RESULT=none
#
# `check --policy FILE` needs FILE mounted read-only into the container, as the engine
# needs to read it; anything else is the engine's usage error (exit 2, nothing on stdout).
# shellcheck disable=SC2016 # single-quoted $names are jq's
set -euo pipefail

log=${FAKE_DOCKER_LOG:?}

record() { jq -cn "$@" >>"$log"; }
# json_array ARGS... prints the arguments as a JSON array of strings.
json_array() { (($#)) && printf '%s\0' "$@" | jq -Rsc 'split("\u0000")[:-1]' || echo '[]'; }

command=$1
shift
case $command in
pull | image)
	record --arg command "$command" --argjson args "$(json_array "$@")" '{command: $command, args: $args}'
	[[ $command == pull ]] || printf '%s\n' "${FAKE_PLATFORM:-linux/amd64}"
	exit 0
	;;
run) ;;
*)
	echo "fake docker: unsupported command $command" >&2
	exit 125
	;;
esac

# docker run [OPTIONS] IMAGE [ARGS]: the options end at the image reference.
options=()
while (($#)) && [[ $1 != ghcr.io/* ]]; do
	options+=("$1")
	shift
done
if ((! $#)); then
	echo "fake docker: no image reference" >&2
	exit 125
fi
image=$1
shift

# mounted PATH prints the host file mounted read-only at PATH in the container, if any.
mounted() {
	local i
	for ((i = 0; i + 1 < ${#options[@]}; i++)); do
		if [[ ${options[i]} == --volume && ${options[i + 1]} == *":$1:ro" ]]; then
			printf '%s' "${options[i + 1]%":$1:ro"}"
			return 0
		fi
	done
	return 1
}
policy_arg=""
args=("$@")
for ((i = 0; i + 1 < ${#args[@]}; i++)); do
	[[ ${args[i]} != --policy ]] || policy_arg=${args[i + 1]}
done
policy_digest=""
if [[ -n $policy_arg ]] && file=$(mounted "$policy_arg") && [[ -f $file ]]; then
	policy_digest=$({ sha256sum "$file" 2>/dev/null || shasum -a 256 "$file"; } | cut -d' ' -f1)
fi
record --arg image "$image" --arg policy "$policy_digest" \
	--argjson options "$(json_array "${options[@]}")" --argjson args "$(json_array "$@")" \
	'{command: "run", image: $image, options: $options, args: $args, policy: $policy}'

case ${1:-} in
--version)
	printf 'archfit version %s (commit , built )\n' "${FAKE_ENGINE_VERSION:-v4.0.0-rc.1}"
	;;
check)
	if [[ -n $policy_arg && -z $policy_digest ]]; then
		echo "archfit: read $policy_arg: open $policy_arg: no such file or directory" >&2
		exit 2
	fi
	if [[ ${FAKE_RESULT:?} == none ]]; then
		echo "archfit: read the added lines: git add --all exited 128: fatal: adding files failed" >&2
		exit "${FAKE_CHECK_RC:-2}"
	fi
	echo "archfit: the engine's notes go to stderr" >&2
	cat "$FAKE_RESULT"
	exit "${FAKE_CHECK_RC:-$(jq -r '{pass: 0, fail: 1, unknown: 2}[.status] // 3' "$FAKE_RESULT")}"
	;;
*)
	echo "fake docker: unsupported engine arguments: $*" >&2
	exit 2
	;;
esac
