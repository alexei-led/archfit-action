#!/usr/bin/env bash
# Test double for the docker CLI. It stands in for the archfit engine image so the
# action's scripts run unchanged, and appends every call to FAKE_DOCKER_LOG as one
# JSON line: the options, the engine arguments, and the digests of the bundle files
# the "container" was given.
#
#   FAKE_FIXTURES             directory of the re-anchor fixtures (tests/fixtures)
#   FAKE_DOCKER_LOG           JSON lines, one per call (required)
#   FAKE_STATE                document that `check` prints
#   FAKE_DRAFT                document that `config init` prints
#   FAKE_ENGINE_VERSION       version that `--version` reports (default v3.2.2)
#   FAKE_PLATFORM             os/arch that `image inspect` reports (default linux/amd64)
#   FAKE_CHECK_RC             exit code of `check`; default is the one its verdict implies,
#                             and 3 prints no report, as the engine does
#   FAKE_BASELINE_COMPARABLE  false keeps gate_reference non_comparable after `baseline`
#   FAKE_BASELINE             file that `baseline` writes as the capture (default: an empty v3 baseline)
#   FAKE_REANCHOR_BASELINE    file that `baseline --reanchor` writes (default: tests/fixtures/reanchored-baseline.json)
#   FAKE_REANCHOR_REPORT_FILE text that `baseline --reanchor` prints on stdout (default: tests/fixtures/reanchor-report.txt)
#   FAKE_REANCHOR_RC          exit code of `baseline --reanchor` (default 0); non-zero prints an engine reason on stderr
#   FAKE_BASE_RC              exit code of `check --base` (default: as without --base); a failure leaves a
#                             worktree in the checkout, as a killed engine does, and writes
#                             /bundle/.archfit-baseline.json, as analysed code can
#   FAKE_BASE_SYMLINK         directory that `check --base` links .archfit-cache to, as hostile code can
#   FAKE_BASE_LOCKED          true leaves a read-only directory with a file under .archfit-cache/worktrees,
#                             and a failed `check --base` makes /bundle read-only after its plant
#
# `check --base` needs what docker and git need for `git worktree add` under a read-only
# .git: the host mountpoint .git/worktrees (else docker fails, 125) and a writable mount
# over /src/.git/worktrees (else git fails, 3). It prints the state with the origin
# fields the engine adds, and leaves the per-commit lock file the engine leaves.
# shellcheck disable=SC2016 # single-quoted $names are jq's
set -euo pipefail

log=${FAKE_DOCKER_LOG:?}
fixtures=${FAKE_FIXTURES:?}
captured=$(dirname "$log")/baseline-captured

record() { jq -cn "$@" >>"$log"; }
# json_array ARGS... prints the arguments as a JSON array of strings.
json_array() { (($#)) && printf '%s\0' "$@" | jq -Rsc 'split("\u0000")[:-1]' || echo '[]'; }

command=$1
shift
case $command in
pull | image)
	record --arg command "$command" --argjson args "$(json_array "$@")" '{command: $command, args: $args}'
	[[ $command == pull ]] || printf '%s\n' "${FAKE_PLATFORM:-linux/amd64}"
	exit 0
	;;
run) ;;
*)
	echo "fake docker: unsupported command $command" >&2
	exit 125
	;;
esac

# docker run [OPTIONS] IMAGE [ARGS]: the options end at the image reference.
options=()
while (($#)) && [[ $1 != ghcr.io/* ]]; do
	options+=("$1")
	shift
done
if ((! $#)); then
	echo "fake docker: no image reference" >&2
	exit 125
fi
image=$1
shift

bundle=""
reference=""
src=""
git_worktrees=""
for ((i = 0; i + 1 < ${#options[@]}; i++)); do
	if [[ ${options[i]} == --volume && ${options[i + 1]} == *:/bundle ]]; then
		bundle=${options[i + 1]%:/bundle}
	fi
	if [[ ${options[i]} == --volume && ${options[i + 1]} == *:/src ]]; then
		src=${options[i + 1]%:/src}
	fi
	if [[ ${options[i]} == --volume && ${options[i + 1]} == *:/src/.git/worktrees ]]; then
		git_worktrees=${options[i + 1]%:/src/.git/worktrees}
	fi
	if [[ ${options[i]} == --volume && ${options[i + 1]} == *:/reference/.archfit-baseline.json:ro ]]; then
		reference=${options[i + 1]%%:/reference/.archfit-baseline.json:ro}
	fi
done
# visible NAME prints the host file the container sees at /bundle/NAME: a file mounted
# over that path wins over the writable directory, as in docker.
visible() {
	local i file=$bundle/$1
	for ((i = 0; i + 1 < ${#options[@]}; i++)); do
		[[ ${options[i]} != --volume || ${options[i + 1]} != *":/bundle/$1:ro" ]] ||
			file=${options[i + 1]%":/bundle/$1:ro"}
	done
	printf '%s' "$file"
}
seen='{}'
for name in .archfit.yaml .archfit-baseline.json .archfit-labels.yaml; do
	file=$(visible "$name")
	if [[ -n $bundle && -f $file ]]; then
		digest=$({ sha256sum "$file" 2>/dev/null || shasum -a 256 "$file"; } | cut -d' ' -f1)
		seen=$(jq -c --arg n "$name" --arg d "$digest" '. + {($n): $d}' <<<"$seen")
	fi
done
reference_digest=""
[[ -z $reference ]] || reference_digest=$({ sha256sum "$reference" 2>/dev/null || shasum -a 256 "$reference"; } | cut -d' ' -f1)
record --arg image "$image" --argjson bundle "$seen" --arg reference "$reference_digest" \
	--argjson options "$(json_array "${options[@]}")" --argjson args "$(json_array "$@")" \
	'{command: "run", image: $image, options: $options, args: $args, bundle: $bundle, reference: $reference}'

case ${1:-} in
--version)
	printf 'archfit version %s (commit , built )\n' "${FAKE_ENGINE_VERSION:-v3.2.2}"
	;;
check)
	if ! jq -e 'has(".archfit.yaml")' <<<"$seen" >/dev/null; then
		echo "error: config not found: /bundle/.archfit.yaml" >&2
		exit 3
	fi
	if [[ ${FAKE_CHECK_RC:-} == 3 ]]; then
		printf 'error: analyzer go/packages failed: go list exited 1\n→ run: archfit doctor\n' >&2
		exit 3
	fi
	echo "fake engine: check /src" >&2
	if [[ " $* " == *" --base "* ]]; then
		base=" $* "
		base=${base##* --base }
		base=${base%% *}
		if [[ ! -d $src/.git/worktrees ]]; then
			echo "docker: Error response from daemon: mkdir $src/.git/worktrees: read-only file system" >&2
			exit 125
		fi
		if [[ -z $git_worktrees || ! -d $git_worktrees ]]; then
			echo "error: cannot create worktree for ref \"$base\": git worktree add: fatal: could not create directory of '.git/worktrees/wt': Read-only file system" >&2
			exit 3
		fi
		cache=$src/.archfit-cache
		if [[ -n ${FAKE_BASE_SYMLINK:-} ]]; then
			ln -s "$FAKE_BASE_SYMLINK" "$cache"
		fi
		mkdir -p "$cache/worktrees/$base/wt" "$git_worktrees/wt"
		: >"$cache/worktrees/$base.lock"
		if [[ -n ${FAKE_BASE_RC:-} ]]; then
			printf 'gitdir: /src/.git/worktrees/wt\n' >"$cache/worktrees/$base/wt/.git"
			printf '{"schema_version":"archfit.baseline.v3","accepted":["planted"]}\n' >"$bundle/.archfit-baseline.json"
			[[ ${FAKE_BASE_LOCKED:-} != true ]] || chmod a-w "$bundle"
			echo "error: cannot create worktree for ref \"$base\": git worktree add exited 128" >&2
			exit "$FAKE_BASE_RC"
		fi
		rm -rf "${cache:?}/worktrees/$base" "$git_worktrees/wt"
		if [[ ${FAKE_BASE_LOCKED:-} == true ]]; then
			mkdir -p "$cache/worktrees/locked"
			: >"$cache/worktrees/locked/file"
			chmod a-w "$cache/worktrees/locked"
		fi
		jq '.comparison += {origin_status: "comparable", introduced_finding_ids: [.findings[0].id], resolved_finding_ids: []}
			| .findings |= (to_entries | map(.value + {origin: (if .key == 0 then "introduced" else "pre_existing" end)}))' "${FAKE_STATE:?}"
	elif [[ -f $captured && ${FAKE_BASELINE_COMPARABLE:-true} == true ]]; then
		jq '.gate_reference = {status: "comparable", base_ref: "baseline", reasons: []}' "${FAKE_STATE:?}"
	else
		cat "${FAKE_STATE:?}"
	fi
	exit "${FAKE_CHECK_RC:-$(jq -r '{healthy: 0, blocked: 1, needs_attention: 2}[.verdict] // 3' "$FAKE_STATE")}"
	;;
config)
	cat "${FAKE_DRAFT:?}"
	;;
baseline)
	if [[ " $* " == *" --reanchor "* ]]; then
		# The engine reads the stored file from its read-only mount and writes the new one to /bundle.
		if [[ -z $reference ]]; then
			echo "error: stored baseline /reference/.archfit-baseline.json: no such file" >&2
			exit 3
		fi
		if [[ ${FAKE_REANCHOR_RC:-0} != 0 ]]; then
			echo 'error: schema version "archfit.baseline.v1" in /reference/.archfit-baseline.json cannot be re-anchored' >&2
			exit "$FAKE_REANCHOR_RC"
		fi
		cp "${FAKE_REANCHOR_BASELINE:-$fixtures/reanchored-baseline.json}" "$bundle/.archfit-baseline.json"
		: >"$captured"
		cat "${FAKE_REANCHOR_REPORT_FILE:-$fixtures/reanchor-report.txt}"
		exit 0
	fi
	if [[ -n ${FAKE_BASELINE:-} ]]; then
		cp "$FAKE_BASELINE" "$bundle/.archfit-baseline.json"
	else
		printf '{"schema_version":"archfit.baseline.v3","accepted":[]}\n' >"$bundle/.archfit-baseline.json"
	fi
	: >"$captured"
	echo "baseline saved: /bundle/.archfit-baseline.json"
	;;
*)
	echo "fake docker: unsupported engine arguments: $*" >&2
	exit 3
	;;
esac
